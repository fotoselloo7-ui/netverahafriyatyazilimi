# ================= Ersan Hafriyat CMS — Ortam Ayarları =================
# Production kurulumunda bu dosyayı ".env" olarak kopyalayıp doldurun.

APP_NAME="Ersan Hafriyat"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://domain.com
# APP_KEY: rastgele uzun bir değer girin (lisans önbellek imzası için de kullanılır)
APP_KEY=
APP_VERSION=1.0.0

# ---- Veritabanı ----
# Production: mysql. Yerel geliştirme için "sqlite" da desteklenir.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Yalnızca DB_CONNECTION=sqlite iken kullanılır:
DB_DATABASE_SQLITE=storage/database.sqlite

# ---- DijiKey Lisans Sistemi (merkezi lisans doğrulama) ----
# VARSAYILAN MOD: production. Bu satır hiç yazılmasa bile sistem production
# kabul eder ve lisans kilidi çalışır. local mod SADECE geliştirici bilinçli
# olarak DIGIKEY_ENV=local yazarsa devreye girer (bypass olarak kullanmayın).
# DIGIKEY_BASE_URL boşsa admin panel "Lisans sunucusu yapılandırılmamış" uyarısı verir.
# DIGIKEY_CACHE_SECRET: lisans önbelleği HMAC imzası için benzersiz gizli değer (boşsa APP_KEY kullanılır).
DIGIKEY_ENV=production
DIGIKEY_BASE_URL=
DIGIKEY_API_SECRET=
DIGIKEY_PRODUCT_SLUG=ersan-hafriyat-cms
DIGIKEY_API_TIMEOUT=10
DIGIKEY_VERIFY_INTERVAL_HOURS=24
DIGIKEY_GRACE_DAYS=7
DIGIKEY_CACHE_SECRET=
# API uç yolları varsayılan DijiKey şemasıdır; farklı bir sunucu şeması
# kullanıyorsanız aşağıdaki satırları açıp özelleştirin:
# DIGIKEY_ENDPOINT_ACTIVATE=/api/v1/activate
# DIGIKEY_ENDPOINT_VERIFY=/api/v1/verify
# DIGIKEY_ENDPOINT_HEARTBEAT=/api/v1/heartbeat
# DIGIKEY_ENDPOINT_HEALTH=/api/v1/public-settings
