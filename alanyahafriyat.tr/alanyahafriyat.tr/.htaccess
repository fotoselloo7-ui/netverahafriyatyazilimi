# ================= Ersan Hafriyat — Kök .htaccess =================
# Yöntem A (cPanel): Tüm proje public_html içine yüklenir; istekler public/'e yönlenir.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Hassas dosya ve klasörleri koru (.env, .sqlite, .md, .sql, dotfile, composer)
<FilesMatch "^(\.env.*|composer\.(json|lock)|.*\.(sqlite|sql|md|log|ps1|bat))$">
    <IfModule mod_authz_core.c>Require all denied</IfModule>
    <IfModule !mod_authz_core.c>Order allow,deny
    Deny from all</IfModule>
</FilesMatch>

# Dizin listelemeyi kapat
Options -Indexes
